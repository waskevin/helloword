[Unit]
Description=TOS 7 Hello World application
After=network.target
Wants=network.target

[Service]
Type=simple
User=helloworld
Group=helloworld
WorkingDirectory=/usr/local/helloworld
ExecStart=/usr/local/helloworld/server.py
Restart=on-failure
RestartSec=3
MemoryMax=256M

[Install]
WantedBy=multi-user.target
